# ─────────────────────────────────────────────────────────────────
#  FPL Scout — Backend Environment Variables
#  Copy this file to .env:
#    cp .env.example .env   (Linux/Mac)
#    copy .env.example .env  (Windows)
# ─────────────────────────────────────────────────────────────────

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────
# docker-compose exposes PostgreSQL on host port 5433
DB_NAME=fpl_manager
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth (optional — leave blank to skip) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── ML Artifacts ──────────────────────────────────────────────────
ML_ARTIFACTS_PATH=ml_artifacts

# ── Groq LLM (optional — only needed for AI Advice page) ─────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=
